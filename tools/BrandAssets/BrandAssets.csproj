<Project Sdk="Microsoft.NET.Sdk">
  <!-- Herramienta: genera el logo transparente y el icono a partir de assets/logo-original.png.
       dotnet run --project tools/BrandAssets -- assets/logo-original.png assets src/DJTube.App/Assets -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
  </ItemGroup>
</Project>
