<Window x:Class="DJTube.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DJTube.App.ViewModels"
        xmlns:views="clr-namespace:DJTube.App.Views"
        xmlns:controls="clr-namespace:DJTube.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DJTube" Height="800" Width="1280" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <DockPanel Margin="16">
        <!-- Salida de audio -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Salida" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextDimBrush}" />
            <ComboBox DockPanel.Dock="Left" Width="280" Focusable="False"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
            <TextBlock Text="{Binding OutputStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Libraries}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOutputError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Barra inferior: atajos y estado de yt-dlp -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Abrir caché" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                    Command="{Binding OpenCacheCommand}" ToolTip="{Binding CacheFolder}" />
            <Button DockPanel.Dock="Right" Content="Actualizar yt-dlp" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                    Command="{Binding UpdateYtDlpCommand}"
                    ToolTip="YouTube cambia a menudo: si fallan las descargas, actualiza yt-dlp" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding YtDlpStatus}" VerticalAlignment="Center" FontSize="11"
                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="460">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasYtDlpError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Atajos — A: Espacio = play/pausa, C = cue · B: Intro = play/pausa, M = cue · Esc = salir del campo de enlace · arrastra enlaces o archivos a un plato" />
        </DockPanel>

        <!-- Vista ampliada de los dos platos (estilo AtomixMP3): cabezal fijo en el centro -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8"
                Margin="0,0,0,12">
            <StackPanel>
                <controls:ZoomWaveform Height="78" Label="A"
                                       Waveform="{Binding DeckA.Waveform}"
                                       Position="{Binding DeckA.PositionSeconds}"
                                       Rate="{Binding DeckA.PlaybackRate}"
                                       Grid="{Binding DeckA.Grid}"
                                       CuePoint="{Binding DeckA.CuePoint}"
                                       Accent="{StaticResource DeckAColor}"
                                       SecondsVisible="{Binding ZoomSeconds}"
                                       SeekCommand="{Binding DeckA.SeekSecondsCommand}" />
                <controls:ZoomWaveform Height="78" Label="B" Margin="0,6,0,0"
                                       Waveform="{Binding DeckB.Waveform}"
                                       Position="{Binding DeckB.PositionSeconds}"
                                       Rate="{Binding DeckB.PlaybackRate}"
                                       Grid="{Binding DeckB.Grid}"
                                       CuePoint="{Binding DeckB.CuePoint}"
                                       Accent="{StaticResource DeckBColor}"
                                       SecondsVisible="{Binding ZoomSeconds}"
                                       SeekCommand="{Binding DeckB.SeekSecondsCommand}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:DeckView Grid.Column="0" DataContext="{Binding DeckA}" AccentColor="{StaticResource DeckAColor}" />
            <views:MixerView Grid.Column="1" DataContext="{Binding Mixer}" Margin="12,0" />
            <views:DeckView Grid.Column="2" DataContext="{Binding DeckB}" AccentColor="{StaticResource DeckBColor}" />
        </Grid>
    </DockPanel>
</Window>
