<Window x:Class="DJTube.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DJTube.App.ViewModels"
        xmlns:views="clr-namespace:DJTube.App.Views"
        xmlns:controls="clr-namespace:DJTube.App.Controls"
        xmlns:loc="clr-namespace:DJTube.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}" Height="1000" Width="1360" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        Icon="pack://application:,,,/Assets/djtube.ico"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <DockPanel>
        <!-- Menú, con el logo a la izquierda -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}">
            <Image DockPanel.Dock="Left" Source="{StaticResource LogoSmall}" Width="22" Height="22"
                   Margin="12,0,2,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <Menu>
                <MenuItem Header="{loc:Tr Menu_File}">
                    <MenuItem Header="{loc:Tr Menu_LoadFileA}" InputGestureText="Ctrl+1"
                              Command="{Binding DeckA.LoadFileCommand}" />
                    <MenuItem Header="{loc:Tr Menu_LoadFileB}" InputGestureText="Ctrl+2"
                              Command="{Binding DeckB.LoadFileCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_OpenCache}" Command="{Binding OpenCacheCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_Record}" Command="{Binding Recording.RecordCommand}" />
                    <MenuItem Header="{loc:Tr Menu_PauseRecording}" Command="{Binding Recording.TogglePauseCommand}"
                              IsEnabled="{Binding Recording.IsRecording}" />
                    <MenuItem Header="{loc:Tr Menu_StopRecording}" Command="{Binding Recording.StopCommand}"
                              IsEnabled="{Binding Recording.IsActive}" />
                    <MenuItem Header="{loc:Tr Rec_OpenFolder}" Command="{Binding Recording.OpenFolderCommand}" />
                    <MenuItem Header="{loc:Tr Menu_History}" InputGestureText="Ctrl+H" Click="OnHistoryClick" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_Exit}" InputGestureText="Alt+F4" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="{loc:Tr Menu_Settings}">
                    <MenuItem Header="{loc:Tr Menu_Preferences}" InputGestureText="Ctrl+," Click="OnPreferencesClick" />
                    <MenuItem Header="{loc:Tr Menu_Midi}" Click="OnMidiClick" />
                    <MenuItem Header="{loc:Tr Menu_Language}">
                        <MenuItem Header="Español" IsChecked="{Binding IsSpanish, Mode=OneWay}"
                                  Command="{Binding SetLanguageCommand}" CommandParameter="es" />
                        <MenuItem Header="English" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                                  Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_UpdateYtDlp}" Command="{Binding UpdateYtDlpCommand}" />
                </MenuItem>
                <MenuItem Header="{loc:Tr Menu_View}">
                    <MenuItem Header="{loc:Tr Menu_ZoomIn}" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" />
                    <MenuItem Header="{loc:Tr Menu_ZoomOut}" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_Library}" InputGestureText="Ctrl+L"
                              IsChecked="{Binding ShowLibrary, Mode=OneWay}" Command="{Binding ToggleLibraryCommand}" />
                </MenuItem>
                <MenuItem Header="{loc:Tr Menu_Help}">
                    <MenuItem Header="{loc:Tr Menu_Shortcuts}" InputGestureText="F1" Click="OnShortcutsClick" />
                    <MenuItem Header="{loc:Tr Menu_CheckUpdates}" Command="{Binding CheckUpdatesNowCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:Tr Menu_About}" Click="OnAboutClick" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Aviso de actualización -->
        <Border DockPanel.Dock="Top" DataContext="{Binding Update}" Padding="16,8"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#FF4A1A2A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                        Command="{Binding DismissCommand}" ToolTip="{loc:Tr Update_Later}" />
                <Button DockPanel.Dock="Right" Content="{loc:Tr Update_Install}" Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding InstallCommand}" Background="{DynamicResource DeckABrush}" Foreground="{DynamicResource OnAccentBrush}"
                        Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="{loc:Tr Update_DownloadPage}" Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding OpenNotesCommand}" Background="{DynamicResource DeckABrush}" Foreground="{DynamicResource OnAccentBrush}"
                        Visibility="{Binding CanDownloadPage, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="{loc:Tr Update_Notes}" Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding OpenNotesCommand}"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar DockPanel.Dock="Right" Width="160" Margin="12,0,0,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"
                             Foreground="{DynamicResource DeckABrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource CueBrush}" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DockPanel Margin="16,12,16,16">
            <!-- Salida de audio y auriculares (pre-escucha) -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <DockPanel.Resources>
                    <DataTemplate x:Key="OptionLabel">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                    <Style x:Key="BarLabel" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                    </Style>
                    <Style x:Key="PhonesIcon" TargetType="TextBlock" BasedOn="{StaticResource BarLabel}">
                        <Setter Property="Text" Value="&#xE7F6;" />
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                        <Setter Property="Margin" Value="18,0,6,0" />
                    </Style>
                </DockPanel.Resources>

                <!-- WASAPI: un dispositivo para el master y otro para los auriculares -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding IsWasapiMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Tr Output}" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="250" Focusable="False" ItemTemplate="{StaticResource OptionLabel}"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                    <TextBlock Style="{StaticResource PhonesIcon}" />
                    <TextBlock Text="{loc:Tr Headphones}" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="250" Focusable="False" ItemTemplate="{StaticResource OptionLabel}"
                              ItemsSource="{Binding CueDevices}" SelectedItem="{Binding SelectedCueDevice}"
                              ToolTip="{loc:Tr HeadphonesTip}" />
                </StackPanel>

                <!-- ASIO: una tarjeta multicanal, master y auriculares en pares de canales -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding IsAsioMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Tr AsioDriver}" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="220" Focusable="False" ItemTemplate="{StaticResource OptionLabel}"
                              ItemsSource="{Binding AsioDevices}" SelectedItem="{Binding SelectedAsioDevice}"
                              ToolTip="{loc:Tr AsioDriverTip}" />
                    <TextBlock Text="{loc:Tr MasterPair}" Style="{StaticResource BarLabel}" Margin="18,0,8,0" />
                    <ComboBox Width="120" Focusable="False" ItemTemplate="{StaticResource OptionLabel}"
                              ItemsSource="{Binding MasterPairs}" SelectedItem="{Binding SelectedMasterPair}" />
                    <TextBlock Style="{StaticResource PhonesIcon}" />
                    <TextBlock Text="{loc:Tr Headphones}" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="130" Focusable="False" ItemTemplate="{StaticResource OptionLabel}"
                              ItemsSource="{Binding CuePairs}" SelectedItem="{Binding SelectedCuePair}"
                              ToolTip="{loc:Tr HeadphonesTip}" />
                </StackPanel>

                <!-- yt-dlp (descargas de YouTube): versión o error, y actualizar -->
                <Button DockPanel.Dock="Right" Content="{loc:Tr UpdateYtDlp}" Padding="8,3" FontSize="11" Margin="8,0,0,0"
                        VerticalAlignment="Center" Command="{Binding UpdateYtDlpCommand}" ToolTip="{loc:Tr UpdateYtDlpTip}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding YtDlpStatus}" VerticalAlignment="Center" FontSize="11"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding YtDlpStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasYtDlpError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Estado de las dos salidas -->
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding OutputStatus}" FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Libraries}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOutputError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CueStatus}" FontSize="11" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCueError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Barra de grabación (bajo la biblioteca) -->
            <views:RecordingBar DockPanel.Dock="Bottom" Margin="0,10,0,0" DataContext="{Binding Recording}" />

            <!-- Vista ampliada de los dos platos (estilo AtomixMP3): cabezal fijo en el centro -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="8"
                    Margin="0,0,0,12">
                <StackPanel>
                    <controls:ZoomWaveform Height="56" Label="A" ToolTip="{loc:Tr ZoomTip}"
                                           Waveform="{Binding DeckA.Waveform}"
                                           Position="{Binding DeckA.PositionSeconds}"
                                           Rate="{Binding DeckA.PlaybackRate}"
                                           Grid="{Binding DeckA.Grid}"
                                           CuePoint="{Binding DeckA.CuePoint}"
                                           Markers="{Binding DeckA.Markers}"
                                           Accent="{DynamicResource DeckAColor}"
                                           SecondsVisible="{Binding ZoomSeconds}"
                                           SeekCommand="{Binding DeckA.SeekSecondsCommand}" />
                    <controls:ZoomWaveform Height="56" Label="B" Margin="0,6,0,0" ToolTip="{loc:Tr ZoomTip}"
                                           Waveform="{Binding DeckB.Waveform}"
                                           Position="{Binding DeckB.PositionSeconds}"
                                           Rate="{Binding DeckB.PlaybackRate}"
                                           Grid="{Binding DeckB.Grid}"
                                           CuePoint="{Binding DeckB.CuePoint}"
                                           Markers="{Binding DeckB.Markers}"
                                           Accent="{DynamicResource DeckBColor}"
                                           SecondsVisible="{Binding ZoomSeconds}"
                                           SeekCommand="{Binding DeckB.SeekSecondsCommand}" />
                </StackPanel>
            </Border>

            <!-- Platos y mezclador; debajo, la biblioteca (el divisor ajusta su alto) -->
            <Grid x:Name="BodyGrid" SizeChanged="OnBodySizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="406" />
                    <RowDefinition x:Name="SplitterRow" Height="10" />
                    <RowDefinition x:Name="LibraryRow" Height="220" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:DeckView Grid.Column="0" DataContext="{Binding DeckA}" AccentColor="{DynamicResource DeckAColor}" />
                    <views:MixerView Grid.Column="1" DataContext="{Binding Mixer}" Margin="12,0" />
                    <views:DeckView Grid.Column="2" DataContext="{Binding DeckB}" AccentColor="{DynamicResource DeckBColor}" />
                </Grid>
                <GridSplitter x:Name="LibrarySplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" Background="Transparent" Focusable="False"
                              DragCompleted="OnLibrarySplitterDragCompleted" />
                <views:LibraryView x:Name="LibraryPanel" Grid.Row="2" DataContext="{Binding Library}" />
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
