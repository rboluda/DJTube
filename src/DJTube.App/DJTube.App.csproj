<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WPF 4.x exige Windows 10 2004 (19041) o superior. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- El ejecutable se llama DJTube.exe; el espacio de nombres (y los recursos) siguen siendo DJTube.App. -->
    <AssemblyName>DJTube</AssemblyName>
    <RootNamespace>DJTube.App</RootNamespace>
    <!-- Requerido por [LibraryImport] (barra de título oscura). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Icono del ejecutable (generado con tools/BrandAssets a partir de assets/logo-original.png). -->
    <ApplicationIcon>Assets\djtube.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\djtube.ico" />
    <Resource Include="Assets\logo-64.png" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DJTube.Core\DJTube.Core.csproj" />
    <ProjectReference Include="..\DJTube.Audio.Bass\DJTube.Audio.Bass.csproj" />
    <ProjectReference Include="..\DJTube.Sources.Local\DJTube.Sources.Local.csproj" />
    <ProjectReference Include="..\DJTube.Sources.YouTube\DJTube.Sources.YouTube.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.153.1" />
  </ItemGroup>

</Project>
