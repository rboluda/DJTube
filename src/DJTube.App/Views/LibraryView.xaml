<UserControl x:Class="DJTube.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DJTube.App.ViewModels"
             xmlns:loc="clr-namespace:DJTube.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             d:DesignWidth="1000" d:DesignHeight="220"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <UserControl.Resources>
        <!-- Botones A / B de cada fila -->
        <Style x:Key="DeckLoadButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Opacity="0.75">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        </Style>

        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="10,8,10,6">
        <DockPanel>
            <!-- Cabecera: título, recuento, análisis; a la derecha importar, buscar, letra y ocultar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                        Command="{Binding DataContext.ToggleLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{loc:Tr Library_ToggleTip}" />
                <Button DockPanel.Dock="Right" Content="A+" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                        Command="{Binding FontLargerCommand}" ToolTip="{loc:Tr Library_FontLarger}" />
                <Button DockPanel.Dock="Right" Content="A−" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                        Command="{Binding FontSmallerCommand}" ToolTip="{loc:Tr Library_FontSmaller}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                        Command="{Binding SearchYouTubeCommand}" ToolTip="{loc:Tr Search_Tip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="YouTube" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBox DockPanel.Dock="Right" x:Name="SearchBox" Width="210" Margin="10,0,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Tr Library_Search}" KeyDown="OnSearchKeyDown" ToolTip="{loc:Tr Search_BoxTip}" />
                <Button DockPanel.Dock="Right" Content="{loc:Tr Library_ImportButton}" Style="{StaticResource SmallButton}"
                        Margin="6,0,0,0" Command="{Binding ImportCommand}" ToolTip="{loc:Tr Library_ImportTip}" />
                <TextBox DockPanel.Dock="Right" x:Name="ImportBox" Width="300"
                         Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Tr Library_Import}" KeyDown="OnImportKeyDown" ToolTip="{loc:Tr Library_ImportTip}" />
                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                           Foreground="{StaticResource DeckABrush}" Margin="2,0,8,0" />
                <TextBlock Text="{loc:Tr Library}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Foreground="{StaticResource CueBrush}" Margin="10,0,0,0" />
                <TextBlock Text="{loc:Tr Library_Hint}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Margin="14,0,8,0" TextTrimming="CharacterEllipsis" ToolTip="{loc:Tr Library_Hint}" />
            </DockPanel>

            <!-- Pre-escucha en curso -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                       Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="■" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                        Command="{Binding StopPreviewCommand}" ToolTip="{loc:Tr Preview_Stop}" />
                <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CueBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding PreviewText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource CueBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Progreso de la importación -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Library_CancelImport}" Style="{StaticResource SmallButton}"
                        Margin="8,0,0,0" Command="{Binding CancelImportCommand}"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0"
                        Command="{Binding DismissImportStatusCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar DockPanel.Dock="Right" Width="180" Minimum="0" Maximum="1" VerticalAlignment="Center"
                             Value="{Binding ImportProgress, Mode=OneWay, TargetNullValue=0}"
                             Foreground="{StaticResource DeckABrush}"
                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ImportStatus}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ImportStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportHasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <Grid>
                <DataGrid x:Name="LibraryGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                          RowHeight="{Binding RowHeight}" FontSize="{Binding FontSize}" ColumnHeaderHeight="26"
                          IsReadOnly="False" HorizontalScrollBarVisibility="Disabled"
                          BeginningEdit="OnBeginningEdit" PreviewKeyDown="OnGridKeyDown" Sorting="OnSorting"
                          PreviewMouseLeftButtonDown="OnGridMouseDown" MouseMove="OnGridMouseMove"
                          PreviewMouseWheel="OnGridMouseWheel">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr Library_LoadA}" Command="{Binding LoadToACommand}" />
                            <MenuItem Header="{loc:Tr Library_LoadB}" Command="{Binding LoadToBCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr Library_Edit}" Click="OnEditClick" />
                            <MenuItem Header="{loc:Tr Library_RemoveFromPlaylist}" Command="{Binding RemoveFromPlaylistCommand}"
                                      Visibility="{Binding Selected.Group.IsPlaylist, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <MenuItem Header="{loc:Tr Library_Delete}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <!-- Árbol: cada lista es una rama que se despliega con sus canciones -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ToggleButton IsChecked="{Binding Name.IsExpanded}" Focusable="False" Cursor="Hand"
                                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Bd" Background="{StaticResource ControlBrush}"
                                                                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                                                                        Padding="8,5" Margin="0,2,0,0" CornerRadius="4">
                                                                    <DockPanel>
                                                                        <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                   Foreground="{StaticResource TextDimBrush}" />
                                                                        <TextBlock x:Name="Icon" Text="&#xE90B;" FontFamily="Segoe MDL2 Assets"
                                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                   Foreground="{StaticResource DeckBBrush}" />
                                                                        <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Name.CountText}" Style="{StaticResource CaptionText}"
                                                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                    </DockPanel>
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{loc:Tr Library_UpdatePlaylist}"
                                                                                      Command="{Binding PlacementTarget.TemplatedParent.Tag.UpdatePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding Name}"
                                                                                      IsEnabled="{Binding Name.IsPlaylist}" />
                                                                            <Separator />
                                                                            <MenuItem Header="{loc:Tr Library_RemovePlaylist}"
                                                                                      Command="{Binding PlacementTarget.TemplatedParent.Tag.RemovePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding Name}"
                                                                                      IsEnabled="{Binding Name.IsPlaylist}" />
                                                                            <MenuItem Header="{loc:Tr Library_RemovePlaylistAndSongs}"
                                                                                      Command="{Binding PlacementTarget.TemplatedParent.Tag.RemovePlaylistAndSongsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                      CommandParameter="{Binding Name}"
                                                                                      IsEnabled="{Binding Name.IsPlaylist}" />
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding Name.IsPlaylist}" Value="False">
                                                                        <Setter TargetName="Icon" Property="Text" Value="&#xE8D6;" />
                                                                        <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ItemsPresenter Margin="14,0,0,0"
                                                                    Visibility="{Binding Name.IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                            <Setter Property="ToolTip" Value="{Binding Track.Link}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="1200" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Cargar en A / B -->
                        <DataGridTemplateColumn Width="96" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="A" Style="{StaticResource DeckLoadButton}"
                                                Background="{StaticResource DeckABrush}"
                                                Command="{Binding DataContext.LoadToACommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="{loc:Tr Library_LoadA}" />
                                        <Button Content="B" Style="{StaticResource DeckLoadButton}" Margin="4,0,0,0"
                                                Background="{StaticResource DeckBBrush}"
                                                Command="{Binding DataContext.LoadToBCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="{loc:Tr Library_LoadB}" />
                                        <Button Content="&#xE7F6;" FontFamily="Segoe MDL2 Assets" Margin="4,0,0,0"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="{loc:Tr Preview_Tip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DeckLoadButton}">
                                                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Track.IsPreviewing}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CueBrush}" />
                                                            <Setter Property="Foreground" Value="Black" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Miniatura del vídeo (crece con la letra) -->
                        <DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Background="{StaticResource ControlBrush}"
                                            Width="{Binding DataContext.ArtworkWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Height="{Binding DataContext.ArtworkHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <Border CornerRadius="3">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Track.Artwork}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn x:Name="ArtistColumn" Header="{loc:Tr Col_Artist}" Width="*"
                                            Binding="{Binding Track.Artist}" SortMemberPath="Track.Artist"
                                            ElementStyle="{StaticResource TrimmedCell}"
                                            EditingElementStyle="{StaticResource CellEditor}" />
                        <DataGridTextColumn Header="{loc:Tr Col_Title}" Width="1.6*"
                                            Binding="{Binding Track.Title}" SortMemberPath="Track.Title"
                                            ElementStyle="{StaticResource TrimmedCell}"
                                            EditingElementStyle="{StaticResource CellEditor}" />
                        <DataGridTextColumn Header="{loc:Tr Col_Duration}" Width="70" IsReadOnly="True"
                                            Binding="{Binding Track.DurationText, Mode=OneWay}" SortMemberPath="Track.Duration"
                                            ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="{loc:Tr Col_Bpm}" Width="64" IsReadOnly="True"
                                            Binding="{Binding Track.BpmText, Mode=OneWay}" SortMemberPath="Track.Bpm"
                                            ElementStyle="{StaticResource RightCell}" />
                        <!-- Tonalidad (Camelot): en verde si encaja con lo que suena -->
                        <DataGridTemplateColumn Header="{loc:Tr Col_Key}" Width="58" SortMemberPath="Track.KeySort">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" CornerRadius="3" Padding="5,0" ToolTip="{loc:Tr Col_KeyTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Track.IsHarmonic}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PlayBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Track.KeyText}" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Track.IsHarmonic}" Value="True">
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Resultados de la búsqueda en YouTube (tapan la biblioteca mientras se ven) -->
                <DockPanel Background="{StaticResource PanelBrush}"
                           Visibility="{Binding IsShowingResults, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Margin="0,0,10,0"
                                Command="{Binding CloseResultsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Tr Search_Back}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressBar DockPanel.Dock="Right" Width="120" IsIndeterminate="True" VerticalAlignment="Center"
                                     Foreground="{StaticResource DeckABrush}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource BrandRedBrush}" />
                        <TextBlock Text="{Binding ResultsTitle}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" IsReadOnly="True"
                              RowHeight="{Binding RowHeight}" FontSize="{Binding FontSize}" ColumnHeaderHeight="26"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseLeftButtonDown="OnGridMouseDown" MouseMove="OnGridMouseMove">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="OnResultDoubleClick" />
                                <Setter Property="ToolTip" Value="{Binding FullTitle}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="122" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="A" Style="{StaticResource DeckLoadButton}" Background="{StaticResource DeckABrush}"
                                                    Command="{Binding DataContext.ResultLoadACommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Tr Library_LoadA}" />
                                            <Button Content="B" Style="{StaticResource DeckLoadButton}" Margin="4,0,0,0" Background="{StaticResource DeckBBrush}"
                                                    Command="{Binding DataContext.ResultLoadBCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Tr Library_LoadB}" />
                                            <Button Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ResultAddCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DeckLoadButton}">
                                                        <Setter Property="Content" Value="+" />
                                                        <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Setter Property="ToolTip" Value="{loc:Tr Search_AddTip}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInLibrary}" Value="True">
                                                                <Setter Property="Content" Value="✓" />
                                                                <Setter Property="Background" Value="{StaticResource PlayBrush}" />
                                                                <Setter Property="Foreground" Value="Black" />
                                                                <Setter Property="ToolTip" Value="{loc:Tr Search_InLibrary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="&#xE7F6;" FontFamily="Segoe MDL2 Assets" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ResultPreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Tr Preview_Tip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DeckLoadButton}">
                                                        <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CueBrush}" />
                                                                <Setter Property="Foreground" Value="Black" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <ProgressBar Width="14" Height="4" Margin="4,0,0,0" IsIndeterminate="True"
                                                         Foreground="{StaticResource DeckABrush}"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Background="{StaticResource ControlBrush}"
                                                Width="{Binding DataContext.ArtworkWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Height="{Binding DataContext.ArtworkHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Border CornerRadius="3">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr Col_Artist}" Width="*" Binding="{Binding Artist}"
                                                ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="{loc:Tr Col_Title}" Width="1.6*" Binding="{Binding Title}"
                                                ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="{loc:Tr Col_Channel}" Width="0.8*" Binding="{Binding Channel}"
                                                ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="{loc:Tr Col_Duration}" Width="70" Binding="{Binding DurationText}"
                                                SortMemberPath="Duration" ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Biblioteca vacía -->
                <TextBlock Text="{loc:Tr Library_Empty}" Style="{StaticResource CaptionText}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsEmptyAndNoResults, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
