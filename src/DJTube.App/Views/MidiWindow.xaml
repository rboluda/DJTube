<Window x:Class="DJTube.App.Views.MidiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DJTube.App.ViewModels"
        xmlns:loc="clr-namespace:DJTube.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MidiViewModel}"
        Title="{loc:Tr Midi_Title}" Width="640" Height="600" MinWidth="460" MinHeight="320"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Midi_Hint}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                   Margin="0,0,0,10" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="{loc:Tr Midi_Rescan}" Padding="10,4" Command="{Binding ConnectCommand}" />
            <TextBlock Text="{Binding DevicesText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8">
                <Run Text="{loc:Tr Midi_LastMessage}" />
                <Run Text="{Binding LastMessage, Mode=OneWay}" FontFamily="Consolas" />
            </TextBlock>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{loc:Tr Midi_ClearAll}" Padding="10,4" Command="{Binding ClearAllCommand}" />
                <Button Content="{loc:Tr Close}" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right"
                        Click="OnCloseClick" />
            </DockPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" RowHeight="30" ColumnHeaderHeight="26"
                  HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr Midi_Action}" Width="*" Binding="{Binding Label}" />
                <DataGridTemplateColumn Header="{loc:Tr Midi_Control}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Control}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLearning}" Value="True">
                                                <Setter Property="Text" Value="{loc:Tr Midi_MoveControl}" />
                                                <Setter Property="Foreground" Value="{DynamicResource CueBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Tr Midi_Learn}" Padding="8,2" FontSize="11"
                                        Command="{Binding DataContext.LearnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{loc:Tr Midi_Clear}" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                                        Command="{Binding DataContext.ClearBindingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
