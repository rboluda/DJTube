<Window x:Class="DJTube.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DJTube.App.Localization"
        Style="{StaticResource DialogWindow}"
        Title="{loc:Tr Shortcuts_Title}">
    <Window.Resources>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{StaticResource DeckABrush}" />
            <Setter Property="Margin" Value="0,4,24,4" />
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Key}" Text="{loc:Tr Key_Space}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_PlayA}" />
            <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="C" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_CueA}" />
            <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="{loc:Tr Key_Enter}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_PlayB}" />
            <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="M" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_CueB}" />
            <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="Ctrl+1" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_LoadA}" />
            <TextBlock Grid.Row="5" Style="{StaticResource Key}" Text="Ctrl+2" />
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_LoadB}" />
            <TextBlock Grid.Row="6" Style="{StaticResource Key}" Text="Ctrl++ / Ctrl+-" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_Zoom}" />
            <TextBlock Grid.Row="7" Style="{StaticResource Key}" Text="Ctrl+," />
            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_Preferences}" />
            <TextBlock Grid.Row="8" Style="{StaticResource Key}" Text="Esc" />
            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_Escape}" />
            <TextBlock Grid.Row="9" Style="{StaticResource Key}" Text="F1" />
            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Desc}" Text="{loc:Tr Sc_Help}" />
            <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                       Text="{loc:Tr Sc_Wheel}" />
        </Grid>
        <Button Content="{loc:Tr Close}" IsCancel="True" IsDefault="True" MinWidth="96"
                HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
