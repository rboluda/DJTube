<Window x:Class="DJTube.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DJTube.App.ViewModels"
        xmlns:loc="clr-namespace:DJTube.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PreferencesViewModel}"
        Style="{StaticResource DialogWindow}"
        Title="{loc:Tr Pref_Title}">
    <StackPanel Margin="20" Width="460">
        <TextBlock Text="{loc:Tr Pref_Language}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
        <TextBlock Text="{loc:Tr Pref_LanguageNote}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        <TextBlock Text="{loc:Tr Pref_OutputMode}" Style="{StaticResource CaptionText}" Margin="0,16,0,4" />
        <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Tr Pref_OutputModeNote}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                   TextWrapping="Wrap" />

        <CheckBox Content="{loc:Tr Pref_CheckUpdates}" IsChecked="{Binding CheckForUpdates}" Margin="0,16,0,0"
                  Foreground="{StaticResource TextBrush}" />

        <TextBlock Text="{loc:Tr Pref_Cache}" Style="{StaticResource CaptionText}" Margin="0,16,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Tr Pref_Open}" Margin="8,0,0,0" Padding="10,4"
                    Command="{Binding OpenCacheCommand}" />
            <TextBox Text="{Binding CacheFolder, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{loc:Tr OK}" IsDefault="True" MinWidth="96" Click="OnOkClick" />
            <Button Content="{loc:Tr Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
