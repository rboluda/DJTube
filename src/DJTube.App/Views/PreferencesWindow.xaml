<Window x:Class="DJTube.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DJTube.App.ViewModels"
        xmlns:loc="clr-namespace:DJTube.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PreferencesViewModel}"
        Style="{StaticResource DialogWindow}"
        SizeToContent="Manual" Width="620" Height="600" ResizeMode="CanResizeWithGrip"
        Title="{loc:Tr Pref_Title}" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <DataTemplate x:Key="OptionLabel">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Tr OK}" IsDefault="True" MinWidth="96" Click="OnOkClick" />
            <Button Content="{loc:Tr Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>

        <TabControl>
            <!-- General -->
            <TabItem Header="{loc:Tr PrefTab_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Pref_Theme}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemeCombo" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                  ItemTemplate="{StaticResource OptionLabel}" />
                        <TextBlock Text="{loc:Tr Pref_ThemeNote}" Style="{StaticResource Note}" />

                        <TextBlock Text="{loc:Tr Pref_Language}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Tr Pref_LanguageNote}" Style="{StaticResource Note}" />

                        <CheckBox Content="{loc:Tr Pref_CheckUpdates}" IsChecked="{Binding CheckForUpdates}" Style="{StaticResource Option}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio -->
            <TabItem Header="{loc:Tr PrefTab_Audio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Pref_OutputMode}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"
                                  ItemTemplate="{StaticResource OptionLabel}" />
                        <TextBlock Text="{loc:Tr Pref_OutputModeNote}" Style="{StaticResource Note}" />

                        <TextBlock Text="{loc:Tr Pref_Buffer}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Buffers}" SelectedItem="{Binding SelectedBuffer}"
                                  ItemTemplate="{StaticResource OptionLabel}" />
                        <TextBlock Text="{loc:Tr Pref_BufferNote}" Style="{StaticResource Note}" />

                        <CheckBox Content="{loc:Tr Pref_Limiter}" IsChecked="{Binding Limiter}" Style="{StaticResource Option}" />
                        <TextBlock Text="{loc:Tr Pref_LimiterNote}" Style="{StaticResource Note}" />

                        <CheckBox Content="{loc:Tr Pref_AutoGain}" IsChecked="{Binding AutoGain}" Style="{StaticResource Option}" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Margin="24,6,0,0"
                                  ItemTemplate="{StaticResource OptionLabel}" IsEnabled="{Binding AutoGain}" />
                        <TextBlock Text="{loc:Tr Pref_AutoGainNote}" Style="{StaticResource Note}" Margin="24,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Mezcla -->
            <TabItem Header="{loc:Tr PrefTab_Mixing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Pref_PitchRange}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PitchRanges}" SelectedItem="{Binding SelectedPitchRange}"
                                  ItemTemplate="{StaticResource OptionLabel}" />

                        <CheckBox Content="{loc:Tr Pref_Quantize}" IsChecked="{Binding Quantize}" Style="{StaticResource Option}" />
                        <TextBlock Text="{loc:Tr Pref_QuantizeNote}" Style="{StaticResource Note}" />

                        <CheckBox Content="{loc:Tr Pref_LockDeck}" IsChecked="{Binding LockPlayingDeck}" Style="{StaticResource Option}" />
                        <TextBlock Text="{loc:Tr Pref_LockDeckNote}" Style="{StaticResource Note}" />

                        <TextBlock Text="{loc:Tr Pref_AutomixFade}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Fades}" SelectedItem="{Binding SelectedFade}"
                                  ItemTemplate="{StaticResource OptionLabel}" />
                        <CheckBox Content="{loc:Tr Pref_AutomixTempo}" IsChecked="{Binding AutomixMatchTempo}" Style="{StaticResource Option}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Grabación -->
            <TabItem Header="{loc:Tr PrefTab_Recording}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Pref_RecordingFormat}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                              ItemTemplate="{StaticResource OptionLabel}" />
                    <TextBlock Text="{loc:Tr Pref_RecordingFormatNote}" Style="{StaticResource Note}" />

                    <TextBlock Text="{loc:Tr Pref_RecordingsFolder}" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Pref_Browse}" Margin="8,0,0,0" Padding="10,4"
                                Command="{Binding BrowseRecordingsFolderCommand}" />
                        <TextBox Text="{Binding RecordingsFolder, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- Biblioteca -->
            <TabItem Header="{loc:Tr PrefTab_Library}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Pref_Cache}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Pref_Open}" Margin="8,0,0,0" Padding="10,4"
                                Command="{Binding OpenCacheCommand}" />
                        <TextBox Text="{Binding CacheFolder, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock Text="{Binding CacheSizeText}" Style="{StaticResource Note}" />

                    <TextBlock Text="{loc:Tr Pref_CacheLimit}" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding CacheLimits}" SelectedItem="{Binding SelectedCacheLimit}"
                              ItemTemplate="{StaticResource OptionLabel}" />
                    <TextBlock Text="{loc:Tr Pref_CacheLimitNote}" Style="{StaticResource Note}" />
                </StackPanel>
            </TabItem>

            <!-- Teclado -->
            <TabItem Header="{loc:Tr PrefTab_Keyboard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Pref_KeysNote}" Style="{StaticResource Note}" Margin="0,0,0,8" />
                    <Button DockPanel.Dock="Bottom" Content="{loc:Tr Pref_KeysReset}" HorizontalAlignment="Left" Padding="10,4"
                            Margin="0,8,0,0" Command="{Binding ResetShortcutsCommand}" />
                    <DataGrid ItemsSource="{Binding Shortcuts}" IsReadOnly="True" RowHeight="28" ColumnHeaderHeight="26"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Midi_Action}" Width="*" Binding="{Binding Label}" />
                            <DataGridTemplateColumn Header="{loc:Tr Pref_Key}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding KeyText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DeckABrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                            <Setter Property="Text" Value="{loc:Tr Pref_PressKey}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource CueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{loc:Tr Pref_KeyChange}" Padding="8,2" FontSize="11"
                                                    Command="{Binding DataContext.CaptureShortcutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Tr Midi_Clear}" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ClearShortcutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
