<UserControl x:Class="DJTube.App.Views.DeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DJTube.App.ViewModels"
             xmlns:controls="clr-namespace:DJTube.App.Controls"
             xmlns:loc="clr-namespace:DJTube.App.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:DeckViewModel}"
             d:DesignWidth="520" d:DesignHeight="320"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" SizeChanged="OnSizeChanged">
    <!-- Con el plato estrecho (IsCompact) se oculta la miniatura, los botones de carga pasan a iconos
         y los loops bajan a su propia fila, para que nada se solape en portátiles pequeños -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                        <Setter Property="Padding" Value="12" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zona principal -->
            <Grid Grid.Column="0">
                <Grid.Resources>
                    <!-- Separación entre filas; en modo estrecho, algo menor para ganar alto -->
                    <Style x:Key="RowGap" TargetType="FrameworkElement">
                        <Setter Property="Margin" Value="0,8,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="TimeText" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="FontSize" Value="20" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Miniatura del vídeo y BPM -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="128" Height="72" Margin="0,0,12,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="{DynamicResource ControlRadius}">
                            <TextBlock Text="♪" FontSize="34" Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{DynamicResource ControlRadius}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Efecto del plato -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsLoaded}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="92" FontSize="11" Focusable="False" ItemsSource="{Binding FxKinds}"
                                      SelectedItem="{Binding SelectedFx}" ToolTip="{loc:Tr Fx_Tip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ToggleButton Content="FX" Margin="4,0,0,0" Padding="7,2" IsChecked="{Binding FxOn}"
                                          Tag="{Binding Accent, ElementName=Root}" ToolTip="{loc:Tr Fx_OnTip}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <controls:Knob Width="26" Height="26" Minimum="0" Maximum="1" DefaultValue="0.5" IsBipolar="False"
                                           Value="{Binding FxAmount}" Accent="{Binding Accent, ElementName=Root}"
                                           ToolTip="{loc:Tr Fx_AmountTip}" />
                            <Button Content="◂" Width="20" Height="22" Padding="0" Margin="8,0,0,0" FontSize="10"
                                    Command="{Binding FxBeatsDownCommand}" ToolTip="{loc:Tr Fx_BeatsTip}" />
                            <TextBlock Text="{Binding FxBeatsText}" Width="30" TextAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12" ToolTip="{loc:Tr Fx_BeatsTip}" />
                            <Button Content="▸" Width="20" Height="22" Padding="0" FontSize="10"
                                    Command="{Binding FxBeatsUpCommand}" ToolTip="{loc:Tr Fx_BeatsTip}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Si no cabe, el bloque del BPM se encoge en vez de pisar el efecto -->
                    <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BpmText}" FontFamily="Consolas" FontSize="30"
                                           Foreground="{Binding Accent, ElementName=Root}" />
                                <TextBlock Text="BPM" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom"
                                           Margin="6,0,0,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding OriginalBpmText}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{Binding AutoGainText}" Style="{StaticResource CaptionText}" Margin="0,0,8,0"
                                           ToolTip="{loc:Tr AutoGainTip}" />
                                <Border CornerRadius="3" Padding="5,0" Background="{DynamicResource ControlBrush}"
                                        ToolTip="{loc:Tr MusicalKeyTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicalKeyText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MusicalKeyText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CueBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Viewbox>
                </Grid>

                <!-- Letra del plato y título -->
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="{Binding Accent, ElementName=Root}" CornerRadius="4"
                            Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </DockPanel>

                <!-- Carga: enlace de YouTube o archivo -->
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <DockPanel.Resources>
                        <!-- En modo estrecho los botones muestran un icono en vez del texto -->
                        <Style x:Key="LoadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="8,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="Margin" Value="6,0,0,0" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>
                    <Button DockPanel.Dock="Right" AutomationProperties.Name="{loc:Tr FileButton}"
                            Command="{Binding LoadFileCommand}" ToolTip="{loc:Tr FileTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LoadButton}">
                                <Setter Property="Content" Value="{loc:Tr FileButton}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                        <Setter Property="Content" Value="&#xE8E5;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" AutomationProperties.Name="{loc:Tr Load}"
                            Click="OnLoadLinkClick" ToolTip="{loc:Tr LoadTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LoadButton}">
                                <Setter Property="Content" Value="{loc:Tr Load}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                        <Setter Property="Content" Value="&#xE896;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBox x:Name="LinkBox" Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Tr LinkHint}" KeyDown="OnLinkKeyDown" />
                </DockPanel>

                <!-- Progreso de carga/descarga -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                            Command="{Binding CancelLoadCommand}" ToolTip="{loc:Tr CancelDownloadTip}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LoadStatus}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="110" />
                    <ProgressBar VerticalAlignment="Center" Minimum="0" Maximum="1"
                                 Value="{Binding LoadProgress, Mode=OneWay, TargetNullValue=0}"
                                 Foreground="{Binding Accent, ElementName=Root}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="IsIndeterminate" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadProgressKnown}" Value="True">
                                        <Setter Property="IsIndeterminate" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </DockPanel>

                <!-- Tiempos -->
                <Grid Grid.Row="4">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,6,0,4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="Margin" Value="0,4,0,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Tr Elapsed}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Elapsed}" Style="{StaticResource TimeText}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Tr Remaining}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Remaining}" Style="{StaticResource TimeText}"
                                   Foreground="{DynamicResource TextDimBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Forma de onda completa: clic o arrastre para saltar -->
                <controls:WaveformOverview Grid.Row="5"
                                           Waveform="{Binding Waveform}"
                                           Progress="{Binding Progress}"
                                           CueFraction="{Binding CueFraction}"
                                           Accent="{Binding AccentColor, ElementName=Root}"
                                           SeekCommand="{Binding SeekCommand}"
                                           Markers="{Binding Markers}"
                                           IsEnabled="{Binding IsLoaded}">
                    <controls:WaveformOverview.Style>
                        <Style TargetType="controls:WaveformOverview">
                            <Setter Property="Height" Value="60" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="Height" Value="44" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:WaveformOverview.Style>
                </controls:WaveformOverview>

                <!-- Hot cues (clic: fijar o saltar · clic derecho: borrar) y loops -->
                <Grid Grid.Row="6" Style="{StaticResource RowGap}" IsEnabled="{Binding IsLoaded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding HotCues}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}" Width="21" Height="26" Padding="0" Margin="0,0,2,0"
                                        FontSize="11" Command="{Binding DataContext.HotCueCommand, ElementName=Root}"
                                        CommandParameter="{Binding Index}" ToolTip="{loc:Tr HotCueTip}">
                                    <Button.InputBindings>
                                        <MouseBinding Gesture="RightClick" Command="{Binding DataContext.DeleteHotCueCommand, ElementName=Root}"
                                                      CommandParameter="{Binding Index}" />
                                    </Button.InputBindings>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="BorderBrush" Value="{Binding Fill}" />
                                            <Setter Property="Foreground" Value="{Binding Fill}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                    <Setter Property="Background" Value="{Binding Fill}" />
                                                    <Setter Property="Foreground" Value="Black" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Los loops van a la derecha de los hot cues o, si no caben, debajo -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Grid.Column" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style x:Key="LoopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Height" Value="26" />
                                <Setter Property="MinWidth" Value="22" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="2,0,0,0" />
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="IN" Command="{Binding LoopInCommand}" ToolTip="{loc:Tr LoopInTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LoopButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoopIn}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PlayBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PlayBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="OUT" Style="{StaticResource LoopButton}" Command="{Binding LoopOutCommand}"
                                ToolTip="{loc:Tr LoopOutTip}" />
                        <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource LoopButton}"
                                Command="{Binding ReloopCommand}" ToolTip="{loc:Tr ReloopTip}" />
                        <Button Content="◂" Style="{StaticResource LoopButton}" Margin="5,0,0,0"
                                Command="{Binding LoopHalveCommand}" ToolTip="{loc:Tr LoopHalveTip}" />
                        <Button Command="{Binding ToggleLoopCommand}" MinWidth="40" ToolTip="{loc:Tr LoopTip}" AutomationProperties.Name="LOOP">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LOOP " FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LoopSizeText}" FontFamily="Consolas" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LoopButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLooping}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PlayBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="▸" Style="{StaticResource LoopButton}" Command="{Binding LoopDoubleCommand}"
                                ToolTip="{loc:Tr LoopDoubleTip}" />
                        <controls:PressButton Content="ROLL" Style="{StaticResource LoopButton}" Margin="5,0,0,0"
                                              PressCommand="{Binding RollDownCommand}" ReleaseCommand="{Binding RollUpCommand}"
                                              ToolTip="{loc:Tr RollTip}" />
                    </StackPanel>
                </Grid>

                <!-- Transporte; a la derecha, BPM ½ / ×2 y SYNC. CUE y ▶ se estrechan si falta sitio -->
                <DockPanel Grid.Row="7" Style="{StaticResource RowGap}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,2,0,0">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="BpmButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="8,3" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                            <Setter Property="Padding" Value="6,0" />
                                            <Setter Property="Height" Value="20" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>
                            <!-- En modo estrecho, ½ y ×2 uno encima del otro -->
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                            <Setter Property="Orientation" Value="Vertical" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="½" Style="{StaticResource BpmButton}" Command="{Binding HalveBpmCommand}"
                                    ToolTip="{loc:Tr HalveTip}" />
                            <Button Content="×2" Command="{Binding DoubleBpmCommand}" ToolTip="{loc:Tr DoubleTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BpmButton}">
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                                <Setter Property="Margin" Value="0,2,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Button Content="SYNC" Command="{Binding SyncCommand}" ToolTip="{loc:Tr SyncTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="Margin" Value="8,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Margin" Value="6,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="84" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" MaxWidth="84" />
                        </Grid.ColumnDefinitions>
                        <controls:PressButton Content="CUE" Height="42" FontSize="15"
                                              PressCommand="{Binding CueDownCommand}"
                                              ReleaseCommand="{Binding CueUpCommand}"
                                              IsEnabled="{Binding IsLoaded}">
                            <controls:PressButton.Style>
                                <Style TargetType="controls:PressButton" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCueLit}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CueBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource CueBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:PressButton.Style>
                        </controls:PressButton>

                        <Button Grid.Column="2" Height="42" FontSize="15"
                                Command="{Binding PlayPauseCommand}" IsEnabled="{Binding IsLoaded}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="▶" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Content" Value="❚❚" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PlayBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PlayBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DockPanel>

                <!-- Errores -->
                <TextBlock Grid.Row="8" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Pitch: arriba = más lento, abajo = más rápido (como en un plato Technics) -->
            <DockPanel Grid.Column="1">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Width" Value="78" />
                        <Setter Property="Margin" Value="16,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="Width" Value="72" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Pitch}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PitchText}" FontFamily="Consolas" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding KeyText}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <ToggleButton Content="{Binding RangeText}" IsChecked="{Binding IsWideRange}"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="{loc:Tr RangeTip}" />
                    <ToggleButton Content="{loc:Tr KeyLock}" IsChecked="{Binding KeyLock}" Margin="0,4,0,0"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="{loc:Tr KeyLockTip}" />
                    <Button Content="0 %" Command="{Binding ResetPitchCommand}" Margin="0,4,0,0"
                            Padding="8,4" FontSize="11" ToolTip="{loc:Tr ResetPitchTip}" />
                </StackPanel>

                <Slider x:Name="PitchFader" Orientation="Vertical" Style="{StaticResource FaderSlider}"
                        IsDirectionReversed="True" TickPlacement="Both" MinHeight="120"
                        Minimum="{Binding PitchRange, Converter={StaticResource NegateConverter}}"
                        Maximum="{Binding PitchRange}"
                        Value="{Binding PitchPercent}"
                        Tag="{Binding Accent, ElementName=Root}"
                        HorizontalAlignment="Center"
                        MouseDoubleClick="OnPitchDoubleClick" PreviewMouseWheel="OnPitchWheel"
                        ToolTip="{loc:Tr PitchWheelTip}" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
