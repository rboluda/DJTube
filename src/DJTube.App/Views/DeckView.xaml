<UserControl x:Class="DJTube.App.Views.DeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DJTube.App.ViewModels"
             xmlns:controls="clr-namespace:DJTube.App.Controls"
             xmlns:loc="clr-namespace:DJTube.App.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:DeckViewModel}"
             d:DesignWidth="520" d:DesignHeight="320"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zona principal -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Miniatura del vídeo y BPM -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="160" Height="90">
                        <Border Background="{StaticResource ControlBrush}" CornerRadius="6">
                            <TextBlock Text="♪" FontSize="34" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding BpmText}" FontFamily="Consolas" FontSize="30"
                                       Foreground="{Binding Accent, ElementName=Root}" />
                            <TextBlock Text="BPM" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom"
                                       Margin="6,0,0,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding OriginalBpmText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="½" Padding="8,3" FontSize="11" Command="{Binding HalveBpmCommand}"
                                    ToolTip="{loc:Tr HalveTip}" />
                            <Button Content="×2" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding DoubleBpmCommand}" ToolTip="{loc:Tr DoubleTip}" />
                            <Button Content="SYNC" Padding="12,3" Margin="8,0,0,0" Command="{Binding SyncCommand}"
                                    ToolTip="{loc:Tr SyncTip}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Letra del plato y título -->
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="{Binding Accent, ElementName=Root}" CornerRadius="4"
                            Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Foreground="Black" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </DockPanel>

                <!-- Carga: enlace de YouTube o archivo -->
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{loc:Tr FileButton}" Margin="8,0,0,0"
                            Command="{Binding LoadFileCommand}" ToolTip="{loc:Tr FileTip}" />
                    <Button DockPanel.Dock="Right" Content="{loc:Tr Load}" Margin="8,0,0,0"
                            Click="OnLoadLinkClick" ToolTip="{loc:Tr LoadTip}" />
                    <TextBox x:Name="LinkBox" Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Tr LinkHint}" KeyDown="OnLinkKeyDown" />
                </DockPanel>

                <!-- Progreso de carga/descarga -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                            Command="{Binding CancelLoadCommand}" ToolTip="{loc:Tr CancelDownloadTip}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LoadStatus}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="110" />
                    <ProgressBar VerticalAlignment="Center" Minimum="0" Maximum="1"
                                 Value="{Binding LoadProgress, Mode=OneWay, TargetNullValue=0}"
                                 Foreground="{Binding Accent, ElementName=Root}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="IsIndeterminate" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadProgressKnown}" Value="True">
                                        <Setter Property="IsIndeterminate" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </DockPanel>

                <!-- Tiempos -->
                <Grid Grid.Row="4" Margin="0,10,0,6">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Tr Elapsed}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" FontSize="26" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Tr Remaining}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Remaining}" FontFamily="Consolas" FontSize="26"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Forma de onda completa: clic o arrastre para saltar -->
                <controls:WaveformOverview Grid.Row="5" Height="56"
                                           Waveform="{Binding Waveform}"
                                           Progress="{Binding Progress}"
                                           CueFraction="{Binding CueFraction}"
                                           Accent="{Binding AccentColor, ElementName=Root}"
                                           SeekCommand="{Binding SeekCommand}"
                                           IsEnabled="{Binding IsLoaded}" />

                <!-- Transporte -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                    <controls:PressButton Content="CUE" Width="88" Height="48" FontSize="15"
                                          PressCommand="{Binding CueDownCommand}"
                                          ReleaseCommand="{Binding CueUpCommand}"
                                          IsEnabled="{Binding IsLoaded}">
                        <controls:PressButton.Style>
                            <Style TargetType="controls:PressButton" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCueLit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource CueBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource CueBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:PressButton.Style>
                    </controls:PressButton>

                    <Button Width="88" Height="48" Margin="10,0,0,0" FontSize="15"
                            Command="{Binding PlayPauseCommand}" IsEnabled="{Binding IsLoaded}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="❚❚" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PlayBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Errores -->
                <TextBlock Grid.Row="7" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Pitch: arriba = más lento, abajo = más rápido (como en un plato Technics) -->
            <DockPanel Grid.Column="1" Width="78" Margin="16,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Pitch}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PitchText}" FontFamily="Consolas" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding KeyText}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <ToggleButton Content="{Binding RangeText}" IsChecked="{Binding IsWideRange}"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="{loc:Tr RangeTip}" />
                    <ToggleButton Content="{loc:Tr KeyLock}" IsChecked="{Binding KeyLock}" Margin="0,4,0,0"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="{loc:Tr KeyLockTip}" />
                    <Button Content="0 %" Command="{Binding ResetPitchCommand}" Margin="0,4,0,0"
                            Padding="8,4" FontSize="11" ToolTip="{loc:Tr ResetPitchTip}" />
                </StackPanel>

                <Slider x:Name="PitchFader" Orientation="Vertical" Style="{StaticResource FaderSlider}"
                        IsDirectionReversed="True" TickPlacement="Both" MinHeight="120"
                        Minimum="{Binding PitchRange, Converter={StaticResource NegateConverter}}"
                        Maximum="{Binding PitchRange}"
                        Value="{Binding PitchPercent}"
                        Tag="{Binding Accent, ElementName=Root}"
                        HorizontalAlignment="Center"
                        MouseDoubleClick="OnPitchDoubleClick" PreviewMouseWheel="OnPitchWheel"
                        ToolTip="{loc:Tr PitchWheelTip}" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
