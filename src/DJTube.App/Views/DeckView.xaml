<UserControl x:Class="DJTube.App.Views.DeckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DJTube.App.ViewModels"
             xmlns:controls="clr-namespace:DJTube.App.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:DeckViewModel}"
             d:DesignWidth="520" d:DesignHeight="320"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zona principal -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera: letra del plato, título y botón de carga -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="{Binding Accent, ElementName=Root}" CornerRadius="4"
                            Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Foreground="Black" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right" Content="CARGAR" Command="{Binding LoadFileCommand}" />
                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Title}" />
                </DockPanel>

                <!-- Tiempos -->
                <Grid Grid.Row="1" Margin="0,14,0,6">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="TRANSCURRIDO" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" FontSize="26" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="RESTANTE" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Remaining}" FontFamily="Consolas" FontSize="26"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Progreso (provisional hasta la forma de onda) -->
                <controls:TrackProgressBar Grid.Row="2" Height="40"
                                           Progress="{Binding Progress}"
                                           CueFraction="{Binding CueFraction}"
                                           Accent="{Binding Accent, ElementName=Root}"
                                           SeekCommand="{Binding SeekCommand}"
                                           IsEnabled="{Binding IsLoaded}" />

                <!-- Transporte -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <controls:PressButton Content="CUE" Width="88" Height="48" FontSize="15"
                                          PressCommand="{Binding CueDownCommand}"
                                          ReleaseCommand="{Binding CueUpCommand}"
                                          IsEnabled="{Binding IsLoaded}">
                        <controls:PressButton.Style>
                            <Style TargetType="controls:PressButton" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCueLit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource CueBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource CueBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:PressButton.Style>
                    </controls:PressButton>

                    <Button Width="88" Height="48" Margin="10,0,0,0" FontSize="15"
                            Command="{Binding PlayPauseCommand}" IsEnabled="{Binding IsLoaded}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="❚❚" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PlayBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Errores -->
                <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Pitch: arriba = más lento, abajo = más rápido (como en un plato Technics) -->
            <DockPanel Grid.Column="1" Width="78" Margin="16,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="PITCH" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PitchText}" FontFamily="Consolas" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding KeyText}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <ToggleButton Content="{Binding RangeText}" IsChecked="{Binding IsWideRange}"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="Rango del pitch: ±8 % / ±16 %" />
                    <ToggleButton Content="KEY LOCK" IsChecked="{Binding KeyLock}" Margin="0,4,0,0"
                                  Tag="{Binding Accent, ElementName=Root}"
                                  ToolTip="Cambiar el tempo sin cambiar el tono" />
                    <Button Content="0 %" Command="{Binding ResetPitchCommand}" Margin="0,4,0,0"
                            Padding="8,4" FontSize="11" ToolTip="Volver a velocidad original (o doble clic en el fader)" />
                </StackPanel>

                <Slider x:Name="PitchFader" Orientation="Vertical" Style="{StaticResource FaderSlider}"
                        IsDirectionReversed="True" TickPlacement="Both" MinHeight="120"
                        Minimum="{Binding PitchRange, Converter={StaticResource NegateConverter}}"
                        Maximum="{Binding PitchRange}"
                        Value="{Binding PitchPercent}"
                        Tag="{Binding Accent, ElementName=Root}"
                        HorizontalAlignment="Center"
                        MouseDoubleClick="OnPitchDoubleClick" PreviewMouseWheel="OnPitchWheel"
                        ToolTip="Rueda del ratón: ajuste fino (0,02 %)" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
