<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Gris Windows 98: cara de botón gris, bordes oscuros, azul marino y verde azulado como acentos, ondas sobre negro. -->
    <sys:Boolean x:Key="ThemeIsDark">False</sys:Boolean>

    <Color x:Key="BackgroundColor">#FF9E9E9E</Color>
    <Color x:Key="PanelColor">#FFC0C0C0</Color>
    <Color x:Key="PanelBorderColor">#FF808080</Color>
    <Color x:Key="ControlColor">#FFD4D0C8</Color>
    <Color x:Key="ControlEdgeColor">#FF404040</Color>
    <Color x:Key="ControlHoverColor">#FFE4E2DC</Color>
    <Color x:Key="TextColor">#FF000000</Color>
    <Color x:Key="TextDimColor">#FF333333</Color>
    <Color x:Key="DeckAColor">#FF000080</Color>
    <Color x:Key="DeckBColor">#FF008080</Color>
    <Color x:Key="CueColor">#FF9A7B00</Color>
    <Color x:Key="PlayColor">#FF006E00</Color>
    <Color x:Key="ErrorColor">#FFB00000</Color>
    <Color x:Key="FaderCapColor">#FFFFFFFF</Color>
    <Color x:Key="BrandRedColor">#FF800000</Color>
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="HoverOverlayColor">#22FFFFFF</Color>
    <Color x:Key="AltRowColor">#0A000000</Color>
    <Color x:Key="RowHoverColor">#1E000080</Color>
    <Color x:Key="MeterOffColor">#30000000</Color>
    <Color x:Key="WaveformBackgroundColor">#FF000000</Color>
    <Color x:Key="WaveformGridColor">#FF003838</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlEdgeBrush" Color="{StaticResource ControlEdgeColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="DeckABrush" Color="{StaticResource DeckAColor}" />
    <SolidColorBrush x:Key="DeckBBrush" Color="{StaticResource DeckBColor}" />
    <SolidColorBrush x:Key="CueBrush" Color="{StaticResource CueColor}" />
    <SolidColorBrush x:Key="PlayBrush" Color="{StaticResource PlayColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="FaderCapBrush" Color="{StaticResource FaderCapColor}" />
    <SolidColorBrush x:Key="BrandRedBrush" Color="{StaticResource BrandRedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="AltRowBrush" Color="{StaticResource AltRowColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="MeterOffBrush" Color="{StaticResource MeterOffColor}" />
    <SolidColorBrush x:Key="WaveformBackgroundBrush" Color="{StaticResource WaveformBackgroundColor}" />
    <SolidColorBrush x:Key="WaveformGridBrush" Color="{StaticResource WaveformGridColor}" />

    <!-- Forma: redondeo de paneles y controles, y fuente -->
    <CornerRadius x:Key="PanelRadius">0</CornerRadius>
    <CornerRadius x:Key="ControlRadius">0</CornerRadius>
    <FontFamily x:Key="UiFont">Tahoma</FontFamily>
</ResourceDictionary>
