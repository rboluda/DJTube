<Project>
  <!-- Ajustes comunes a todos los proyectos de la solución. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Las DLL nativas de BASS son x64: todo el proceso debe ser x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Authors>DJTube</Authors>
    <Product>DJTube</Product>
  </PropertyGroup>
</Project>
